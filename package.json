{
  "name": "github-intelligence-extension",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Chrome Extension (Manifest V3) for GitHub Project Intelligence, Architecture Diagrams & Repository Insights — Powered by WXT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.1.4",
    "happy-dom": "^21.0.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  }
}
